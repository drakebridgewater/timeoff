# Copy into Dockhand's stack variables. Every value has a default; set the ones that differ.
SITE_HOST=timeoff.bridgewater.digital
GITHUB_OWNER=drakebridgewater
IMAGE_TAG=latest
APPDATA=/mnt/user/appdata/timeoff
PUID=99
PGID=100
TZ=America/Los_Angeles
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=https
TRAEFIK_CERTRESOLVER=cloudflare
AUTHELIA_MIDDLEWARE=default-secure@file
AUTH_URL=https://authelia.bridgewater.digital
TRUST_USER_HEADER=true
# Only with docker-compose.sablier.yml
SABLIER_URL=http://sablier:10000
SABLIER_SESSION=30m
